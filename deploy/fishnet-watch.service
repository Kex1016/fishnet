# Install: see deploy/README.md. Edit User= and the two paths to match the host.
[Unit]
Description=Deploy fishnet when origin/main changes
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=fishnet
WorkingDirectory=/opt/fishnet
ExecStart=/opt/fishnet/deploy/watch.sh
TimeoutStartSec=20min
Nice=10
