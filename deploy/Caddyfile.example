# Add to the host's Caddyfile (or drop into a file it imports), then `caddy reload`.
fishnet.haiiro.moe {
	encode zstd gzip

	# The few files in static/ come without a Cache-Control from the Node server (hashed /_app/immutable/
	# files, /img/icon and /img/face already carry their own): let browsers keep them a day.
	@static path /favicon.svg /robots.txt /img/face-default.png
	header @static Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	reverse_proxy 127.0.0.1:3000
}

# If Caddy runs in Docker instead: put it and fishnet on one network and use
#   reverse_proxy fishnet:3000
# (and remove the `ports:` line in compose.yml if nothing else on the host needs it).
