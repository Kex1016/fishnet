# fishnet runtime configuration (PLAN §4). Copy to .env on the host; never commit .env.
# The cakeutils v2 API on the Velocity proxy, and a token with read:players read:stats read:onesoul
# (cakectl token create fishnet read:players read:stats read:onesoul --rate 600/120).
CAKEUTILS_API_URL=http://127.0.0.1:8085
CAKEUTILS_API_TOKEN=
# Requests per minute the site allows itself (below the token's rate). Default 400.
CAKEUTILS_RATE=400
# Requests the site may send back to back, below the token's burst (cakectl --rate 600/120 gives 120). Default 60.
CAKEUTILS_BURST=60
# The public origin, for absolute links and SvelteKit's origin check.
ORIGIN=https://fishnet.haiiro.moe
# Where the recorder's SQLite file and caches live (a volume in compose.yml). Default data.
FISHNET_DATA_DIR=data
# Opted-out players, one UUID or name per line. Default data/hidden-players.txt.
HIDDEN_PLAYERS_FILE=data/hidden-players.txt
# Servers the site never shows (cakeutils server ids), one per line. Default data/hidden-servers.txt.
HIDDEN_SERVERS_FILE=data/hidden-servers.txt
# Site-side admin secret for /admin (stat names, hidden servers and players), at least 24 characters,
# e.g. `openssl rand -base64 32`. Not the cakeutils token. Leave empty to switch /admin off.
FISHNET_ADMIN_TOKEN=
# Behind Caddy: lets /admin's sign-in limit see each visitor's address (Caddy adds X-Forwarded-For).
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
# Development only: answer from fixtures instead of cakeutils (fresh | busy). A production build
# refuses to start with it set.
# FISHNET_MOCK=busy
